rules_version = '2';

// ============================================
// 🦄 UNICORN Capture（單人版）— Storage 規則
// 只有擁有者能讀寫 uploads/，單檔上限 20MB。
// ============================================

service firebase.storage {
  match /b/{bucket}/o {

    function isOwner() {
      return request.auth != null && request.auth.token.email.lower() == 'joeshi@dbyv.org';
    }

    match /uploads/{allPaths=**} {
      allow read: if isOwner();
      allow write: if isOwner() && request.resource.size < 20 * 1024 * 1024;
    }
  }
}
