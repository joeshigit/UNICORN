rules_version = '2';

// ============================================
// 🦄 UNICORN Capture — Storage 規則
// 任何登入使用者皆可上傳（單檔上限 20MB）並讀取。
// （檔案連結的能見度主要由 Firestore 的 Submission 權限保護）
// ============================================

service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    match /uploads/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.resource.size < 20 * 1024 * 1024;
    }
  }
}
