rules_version = '2';

// ============================================
// 🦄 UNICORN Capture — Firestore 安全規則
//
// 身分邊界：已驗證的 @dbyv.org
// 角色：
//   Superuser — 管理選項池／建表／看全部／代為更正作廢（不改擁有者）
//   Manager   — 讀取所管表格的全部 submission（不可更正／作廢他人）
//   Submitter — 填授權表格、讀自己的 submission、更正／作廢自己的鏈
//
// submissions 不可變：更正／作廢 = 新文件；舊文件只允許交棒指標。
// ============================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function authEmail() {
      return request.auth.token.email.lower();
    }

    function isOrgUser() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@dbyv\\.org$');
    }

    function isSuperuser() {
      return isOrgUser() && (
        authEmail() == 'joeshi@dbyv.org'
      );
    }

    function roleDocPath() {
      return /databases/$(database)/documents/userRoles/$(authEmail());
    }

    function hasRoleDoc() {
      return isOrgUser() && exists(roleDocPath());
    }

    function getMyGroups() {
      return hasRoleDoc() ? get(roleDocPath()).data.groups : [];
    }

    function isListOfStrings(value) {
      return value is list;
    }

    function templatePath(templateId) {
      return /databases/$(database)/documents/templates/$(templateId);
    }

    function templateExists(templateId) {
      return exists(templatePath(templateId));
    }

    function getTemplate(templateId) {
      return get(templatePath(templateId)).data;
    }

    function isManagerOfForm(templateId) {
      return templateExists(templateId)
        && getTemplate(templateId).keys().hasAny(['managerGroups'])
        && isListOfStrings(getTemplate(templateId).managerGroups)
        && getTemplate(templateId).managerGroups.size() > 0
        && hasRoleDoc()
        && isListOfStrings(getMyGroups())
        && getMyGroups().hasAny(getTemplate(templateId).managerGroups);
    }

    function canFillTemplateData(data) {
      return data.enabled == true && (
        !data.keys().hasAny(['fillAccessType'])
        || data.fillAccessType == 'allOrgUsers'
        || (
          data.fillAccessType == 'groups'
          && data.keys().hasAny(['fillGroups'])
          && isListOfStrings(data.fillGroups)
          && data.fillGroups.size() > 0
          && hasRoleDoc()
          && isListOfStrings(getMyGroups())
          && getMyGroups().hasAny(data.fillGroups)
        )
      );
    }

    function canFillTemplate(templateId) {
      return templateExists(templateId) && canFillTemplateData(getTemplate(templateId));
    }

    // 清單／聚合查詢的規則是對「查詢條件推導出的 resource」求值，沒有被條件約束的
    // 欄位是 undefined。所以清單查詢必須用 _submitterUid 過濾才判得出擁有者身分。
    function isOwnerOfRecord() {
      return isOrgUser()
        && resource.data.keys().hasAll(['_submitterUid'])
        && resource.data._submitterUid == request.auth.uid;
    }

    // 未約束 _templateId 的清單查詢應該乾淨地被拒，而不是丟出
    // 「Property _templateId is undefined」這種難懂的錯誤
    function recordHasTemplateId() {
      return resource.data.keys().hasAll(['_templateId']);
    }

    function submissionPath(id) {
      return /databases/$(database)/documents/submissions/$(id);
    }

    function chainParent() {
      return get(submissionPath(request.resource.data._supersedes)).data;
    }

    function hasValidChainParent() {
      return request.resource.data.keys().hasAny(['_supersedes'])
        && request.resource.data._supersedes is string
        && exists(submissionPath(request.resource.data._supersedes))
        && chainParent()._isLatest == true
        && chainParent()._submitterUid == request.resource.data._submitterUid
        && chainParent()._submitterEmail.lower() == request.resource.data._submitterEmail.lower();
    }

    function actorIsSelf() {
      return request.resource.data._actorUid == request.auth.uid
        && request.resource.data._actorEmail.lower() == authEmail();
    }

    function ownerIsSelf() {
      return request.resource.data._submitterUid == request.auth.uid
        && request.resource.data._submitterEmail.lower() == authEmail();
    }

    function requiredCreateFields() {
      return request.resource.data.keys().hasAll([
        '_templateId', '_templateVersion', '_submittedMonth',
        '_isLatest', '_status', '_eventKind',
        '_submitterUid', '_submitterEmail',
        '_actorUid', '_actorEmail',
        '_eventType', '_templateModule', '_templateAction'
      ])
        && request.resource.data._templateId is string
        && request.resource.data._templateVersion is number
        && request.resource.data._submittedMonth is string
        && request.resource.data._isLatest == true
        && request.resource.data._eventType is string
        && actorIsSelf();
    }

    function isValidCreateEvent() {
      return request.resource.data._eventKind == 'CREATE'
        && request.resource.data._status == 'ACTIVE'
        && ownerIsSelf()
        && !request.resource.data.keys().hasAny(['_supersedes'])
        && canFillTemplate(request.resource.data._templateId);
    }

    function isValidCorrectionEvent() {
      return request.resource.data._eventKind == 'CORRECTION'
        && request.resource.data._status == 'ACTIVE'
        && hasValidChainParent()
        && (
          ownerIsSelf()
          || (
            isSuperuser()
            && request.resource.data._submitterUid == chainParent()._submitterUid
            && request.resource.data._submitterEmail.lower() == chainParent()._submitterEmail.lower()
          )
        );
    }

    function isValidVoidEvent() {
      return request.resource.data._eventKind == 'VOID'
        && request.resource.data._status == 'VOID'
        && hasValidChainParent()
        && (
          ownerIsSelf()
          || (
            isSuperuser()
            && request.resource.data._submitterUid == chainParent()._submitterUid
            && request.resource.data._submitterEmail.lower() == chainParent()._submitterEmail.lower()
          )
        );
    }

    // ---------- userRoles ----------
    match /userRoles/{email} {
      allow read: if isSuperuser() || (isOrgUser() && authEmail() == email);
      allow write: if isSuperuser();
    }

    // ---------- optionSets：組織可讀，Superuser 可寫 ----------
    match /optionSets/{optionSetId} {
      allow read: if isOrgUser();
      allow write: if isSuperuser();
    }

    // 標準 KEY 答案契約（key/type/valueModel/optionSet/scale/yesNo/allowNa）建立後不可改；僅 meaning/defaultLabel/status
    function standardKeyMetaUpdateOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['meaning', 'defaultLabel', 'status', 'updatedAt'])
        && (request.resource.data.status == 'active'
            || request.resource.data.status == 'deprecated');
    }

    // ---------- standardKeys：組織標準 KEY；禁刪（只 deprecate）----------
    match /standardKeys/{standardKeyId} {
      allow read: if isOrgUser();
      allow create: if isSuperuser();
      allow update: if isSuperuser() && standardKeyMetaUpdateOnly();
      allow delete: if false;
    }

    // ---------- templates ----------
    match /templates/{templateId} {
      allow read: if isSuperuser()
        || (isOrgUser() && canFillTemplateData(resource.data))
        || (isOrgUser() && isManagerOfForm(templateId));
      allow write: if isSuperuser();
    }

    // ---------- uploadSessions：送出前暫存擁有權 ----------
    match /uploadSessions/{sessionId} {
      allow read: if isOrgUser()
        && (isSuperuser() || resource.data.uid == request.auth.uid);
      allow create: if isOrgUser()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email.lower() == authEmail()
        && request.resource.data.submissionId == sessionId
        && request.resource.data.expiresAt is timestamp;
      allow update: if isOrgUser()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.submissionId == resource.data.submissionId;
      allow delete: if isOrgUser()
        && (isSuperuser() || resource.data.uid == request.auth.uid);
    }

    // ---------- submissions ----------
    match /submissions/{submissionId} {
      allow read: if isSuperuser()
        || isOwnerOfRecord()
        || (recordHasTemplateId() && isManagerOfForm(resource.data._templateId));

      allow create: if isOrgUser()
        && requiredCreateFields()
        && (
          isValidCreateEvent()
          || isValidCorrectionEvent()
          || isValidVoidEvent()
        );

      allow update: if (isSuperuser() || isOwnerOfRecord())
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['_isLatest', '_supersededBy'])
        && resource.data._isLatest == true
        && request.resource.data._isLatest == false
        && request.resource.data._supersededBy is string;

      allow delete: if false;
    }
  }
}
