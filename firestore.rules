rules_version = '2';

// ============================================
// 🦄 UNICORN Capture（單人版）— Firestore 安全規則
//
// 只有一位擁有者。想換人或加人，改下面的 owner() 即可。
//
// submissions 的重點：資料寫進去就不能改。
// 更正 / 作廢一律是「再寫一筆新的」，舊紀錄只允許翻動
// _isLatest / _supersededBy 這兩個鏈頭指標。
// ============================================

service cloud.firestore {
  match /databases/{database}/documents {

    function owner() {
      return 'joeshi@dbyv.org';
    }

    function isOwner() {
      return request.auth != null && request.auth.token.email.lower() == owner();
    }

    // 選項池：Meaning Layer
    match /optionSets/{optionSetId} {
      allow read, write: if isOwner();
    }

    // 表格定義：Template Layer（純資料）
    match /templates/{templateId} {
      allow read, write: if isOwner();
    }

    // 單一資料池：Submission Layer（不可變事件）
    match /submissions/{submissionId} {
      allow read: if isOwner();

      allow create: if isOwner()
                    && request.resource.data._submitterEmail.lower() == owner()
                    && request.resource.data._templateId is string
                    && request.resource.data._templateVersion is number
                    && request.resource.data._submittedMonth is string
                    && request.resource.data._isLatest == true
                    && request.resource.data._status in ['ACTIVE', 'VOID'];

      // 唯一允許的更新：把鏈頭指標交棒給更正 / 作廢後的新紀錄
      allow update: if isOwner()
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['_isLatest', '_supersededBy'])
                    && resource.data._isLatest == true
                    && request.resource.data._isLatest == false
                    && request.resource.data._supersededBy is string;

      allow delete: if false;
    }
  }
}
