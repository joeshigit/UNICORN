# 複製成 .env.local 後填入自己的值

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=unicorn-dcs.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=unicorn-dcs
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=unicorn-dcs.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# 唯一可以使用這套系統的帳號
# 改這裡的同時，也要改 firestore.rules 與 storage.rules 裡的 owner
NEXT_PUBLIC_OWNER_EMAIL=joeshi@dbyv.org
