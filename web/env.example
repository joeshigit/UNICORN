# 複製成 .env.local
# 以下是 unicorn-dcs 專案的前端設定（這些值本來就會出現在網頁原始碼裡，不是密鑰）

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDAnIoYyATqbibaqxokF6LzCHAnYO0IRrk
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=unicorn-dcs.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=unicorn-dcs
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=unicorn-dcs.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=880489203156
NEXT_PUBLIC_FIREBASE_APP_ID=1:880489203156:web:be6f19d28cf543aa464241

# Superuser 清單的前端便利來源（真正授權以 firestore.rules / storage.rules 為準）
# 組織網域固定為 @dbyv.org（已驗證 Google 帳號）
NEXT_PUBLIC_OWNER_EMAIL=joeshi@dbyv.org

# 本機接 Firebase 模擬器時才打開（設 1）
# 打開時上面的 PROJECT_ID 要跟 `firebase emulators:start --project xxx` 一致
# NEXT_PUBLIC_USE_EMULATOR=1
